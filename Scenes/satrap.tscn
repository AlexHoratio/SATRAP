[sub_resource type="GDScript" id="GDScript_83ioq"]
script/source = "extends Label

func _ready():
	pass
	
func _process(delta):
	update_text()
	
	self_modulate = Color.RED if Ticks.game_paused else Color.GREEN
	
func update_text() -> void:
	var datetime = Ticks.get_date_string()
	var day_string = str(datetime[\"day\"])
			
	if str(datetime[\"day\"]).substr(0, 1) == \"1\":
		day_string += \"th\"
	else:
		match str(datetime[\"day\"]).substr(len(str(datetime[\"day\"])) - 1):
			\"1\":
				day_string += \"st\"
			\"2\":
				day_string += \"nd\"
			\"3\":
				day_string += \"rd\"
			_:
				day_string += \"th\"
		
			
	var month_string = \"\"
	match datetime[\"month\"]:
		1:
			month_string = \"January\"
		2:
			month_string = \"February\"
		3:
			month_string = \"March\"
		4:
			month_string = \"April\"
		5:
			month_string = \"May\"
		6:
			month_string = \"June\"
		7:
			month_string = \"July\"
		8:
			month_string = \"August\"
		9:
			month_string = \"September\"
		10:
			month_string = \"October\"
		11:
			month_string = \"November\"
		12:
			month_string = \"December\"
		_:
			month_string = \"some bs month I never herad of bearfore\"
			
	text = \"Year \" + str(datetime[\"year\"] - 1969) + \" - \" + day_string + \" of \" + month_string
"

[sub_resource type="GDScript" id="GDScript_0a1jj"]
script/source = "extends LinkButton

func _process(delta):
	text = \"> PAUSED <\" if Ticks.game_paused else \"> PLAYING <\"
	self_modulate = Color.RED if Ticks.game_paused else Color.GREEN

func _on_pressed():
	Ticks.toggle_pause()
"

[sub_resource type="GDScript" id="GDScript_sncgy"]
script/source = "extends LinkButton

func _process(delta):
	text = \"x\" + str(float(Ticks.speed_multiplier))
	self_modulate = Color.RED if Ticks.game_paused else Color.GREEN
	
func _on_pressed():
	Ticks.increment_speed()
"

[sub_resource type="GDScript" id="GDScript_af5lw"]
script/source = "extends Label

func _ready():
	pass
	
func _process(delta):
	text = \"Food: \" + str(int(Ticks.resources[\"food\"]))
"


[sub_resource type="GDScript" id="GDScript_8a5t6"]
script/source = "extends NinePatchRect

var hovering = false

func _ready():
	pass

func _process(delta):
	scale = lerp(scale, Vector2(1.1, 1.1) if hovering else Vector2(1, 1), 15 * delta)

func _on_button_mouse_entered():
	hovering = true

func _on_button_mouse_exited():
	hovering = false
"

